<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>KlipioSetup</AssemblyName>
    <RootNamespace>KlipioSetup</RootNamespace>
    <ApplicationIcon>..\..\windows\runner\resources\app_icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <Target Name="RetiredInstaller" BeforeTargets="PrepareForBuild">
    <Error Text="Legacy setup is retired. Run BUILD_FULL_WINDOWS_INSTALLER.bat for the versioned Inno Setup package." />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="$(KlipioPayload)" LogicalName="KlipioApp.zip" />
    <EmbeddedResource Include="..\..\assets\branding\KlipioLogo.jpeg" LogicalName="KlipioLogo.jpeg" />
  </ItemGroup>
</Project>
