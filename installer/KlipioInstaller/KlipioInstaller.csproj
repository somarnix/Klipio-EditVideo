<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>KlipioSetup</AssemblyName>
    <RootNamespace>KlipioSetup</RootNamespace>
    <Version>2.0.19</Version>
    <AssemblyVersion>2.0.19.0</AssemblyVersion>
    <FileVersion>2.0.19.0</FileVersion>
    <KlipioPayload Condition="'$(KlipioPayload)' == ''">..\payload\KlipioApp-v2.0.19-installer-runtime.zip</KlipioPayload>
    <ApplicationIcon>..\..\windows\runner\resources\app_icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(KlipioPayload)" LogicalName="KlipioApp.zip" />
    <EmbeddedResource Include="..\..\assets\branding\KlipioLogo.jpeg" LogicalName="KlipioLogo.jpeg" />
  </ItemGroup>
</Project>
